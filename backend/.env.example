# Copy to backend/.env and replace every placeholder. Never commit backend/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Comma-separated exact frontend origins; no wildcards or paths.
CORS_ORIGINS=http://localhost:5173
DB_HOST=REPLACE_WITH_DATABASE_HOST
DB_PORT=3306
DB_NAME=REPLACE_WITH_DATABASE_NAME
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_CONNECTION_LIMIT=5
